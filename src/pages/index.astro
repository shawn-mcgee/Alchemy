---
import Page from "../layouts/Page.astro";
import Version from "../components/Version.astro";
import { FolderPlus, FolderOpen, Users, FlameKindling, WandSparkles, Swords, BookOpen, BookUp, Book, LibraryBig, FlaskConical } from "@lucide/astro";
---

<Page>
  <div class="absolute w-dvw h-dvh flex flex-col justify-center items-center">

    <div class="flex flex-col w-52 items-center gap-1">

      <div class="flex flex-row justify-center items-center gap-2">
        <FlaskConical/>
        <span class="text-3xl font-bold">
          Alchemy
        </span>
      </div>

      <a href="/new" class="btn btn-primary btn-block">
        <FlameKindling/>
        <span class="flex-1">New Campaign</span>
      </a>

      <a href="/load" class="btn btn-primary btn-block">
        <LibraryBig/>
        <span class="flex-1">Load Campaign</span>
      </a>

      <a href="/join" class="btn btn-primary btn-block">
        <Swords/>
        <span class="flex-1">Join Campaign</span>
      </a>

    </div>

    <Version/>
  </div>
</Page>