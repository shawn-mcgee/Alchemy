---
import Page from "../../layouts/Page.astro";

import GameSummary from "../../components/new/GameSummary.astro";
import Players     from "../../components/new/Players.astro";
---

<Page>
  <div class="absolute w-dvw h-dvh flex flex-col justify-center items-center gap-2">
    

    <div class="flex flex-row bg-base-200 rounded-box p-4">

      <div class="flex flex-col w-98">
        <span class="text-center text-xl font-bold">
          New Game
        </span>
        <GameSummary/>
      </div>      

      <div class="flex flex-col w-98">
        <span class="text-xl text-center font-bold">
          Who is Playing?
        </span>
        <Players/>
      </div>

    </div>


  </div>
</Page>