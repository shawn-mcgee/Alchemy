---

import { Dices, Info } from "@lucide/astro";

import words from "../../../public/words.json";

import _ from "lodash";
const { sample }  =  _;

let playerTitle       = (""
  + sample(words.adjective  .other )
  + " "
  + sample(words.noun.person.player)
)

if (playerTitle.match(/^[aeiouAEIOU]/))
  playerTitle = "An " + playerTitle;
else
  playerTitle = "A " + playerTitle;
---

<div class="flex flex-row items-center">
      
  <div contenteditable class="input input-ghost h-fit text-xl">
    { playerTitle }
  </div>
  
</div>