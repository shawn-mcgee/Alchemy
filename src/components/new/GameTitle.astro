---
import { Dices, Info } from "@lucide/astro";
import words from "../../../public/words.json";

import _ from "lodash";
const { sample }  =  _;

const gameTitle       = ("The "
  + sample(words.adjective.other)
  + " "
  + sample(words.noun     .place)
)
---

<div class="flex flex-row items-center">          
  <span contenteditable class="input input-ghost text-xl h-fit">
    { gameTitle }
  </span>
</div>