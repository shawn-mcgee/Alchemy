---
import { X, User, Dices } from "@lucide/astro";
import PlayerTitle       from "./PlayerTitle.astro";
import PlayerDescription from "./PlayerDescription.astro";
---

<div class="flex flex-row items-center p-2 rounded-box hover:bg-base-200">
  <div class="aspect-square rounded-full p-2 bg-secondary text-secondary-content">
    <User/>
  </div>

  <div class="w-2"/>

  <div class="w-full flex flex-col">
    <PlayerTitle/>
    <PlayerDescription/>
  </div>

  <div class="w-2"/>

  <div class="tooltip" data-tip="Reroll this Player's title and description.">
    <a class="btn btn-xs btn-ghost btn-circle">
      <Dices/>
    </a>
  </div>

  <div class="tooltip" data-tip="Remove this player.">
    <a class="btn btn-xs btn-ghost btn-circle">
      <X/>
    </a>
  </div>
</div>